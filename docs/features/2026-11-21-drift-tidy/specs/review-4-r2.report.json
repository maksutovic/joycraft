  "findings": [
    {
      "id": "f1-no-hunk-bypass",
      "class": "follow-up",
      "origin": "new",
      "criterion": "spec-4-2",
      "at": "payload/.joycraft/runtime/cleanup.mjs:600",
      "summary": "Round-1 blocking finding: FIXED in d66e927. rawDiff passes --text --no-textconv; notLines and the no-hunk guard refuse mode, type and binary changes (probes B1-B4, M1, M2 refused; tests review-4-1 pass). Listed only to record its status."
    },
    {
      "id": "f7-hunk-regex-line-separator",
      "class": "blocking",
      "origin": "new",
      "criterion": "spec-4-2",
      "at": "payload/.joycraft/runtime/cleanup.mjs:651",
      "summary": "Regression from d66e927. The new hunk regex /^@@ ... @@.*\\n(...)/gm needs .*\\n after the header, but JS \".\" does not match U+2028 or U+2029. Git puts the nearest preceding \"funcname\" line (any line that starts with a letter, or a line chosen by a custom diff.<driver>.xfuncname) after @@. When that HEAD line holds U+2028/U+2029, the regex skips the whole hunk, and its lines are never checked. Probe LS1: valid fix of line 5 plus a rewrite of unnamed line 7 passes with a commit message. The round-1 regex (header only, no .*\\n) did read that hunk. Fix direction: match the header with [^\\n]* and the body lines with [^\\n]* (or split the diff on \"\\n\"), and refuse when the number of @@ lines differs from the number of parsed hunks."
    },
    {
      "id": "f8-crlf-stillnames-skipped",
      "class": "follow-up",
      "origin": "new",
      "at": "payload/.joycraft/runtime/cleanup.mjs:651",
      "summary": "Same root cause in the hunk body: [-+\\\\].* stops at \\r (and U+2028), so on a CRLF page the body capture ends after the first \"-\" line and \"fresh\" is empty. The new stillNames guard (round-1 f4) then never runs: CR2 (getWidget() without backticks) and CR3 (`getWidget ()`) on a CRLF page pass; LS2 (U+2028 before getWidget()) passes. Spec criteria still hold (the finding itself is cleared), so this is a follow-up; the f7 fix also fixes it."
    },
    {
      "id": "f9-submodule-ignore-all",
      "class": "follow-up",
      "origin": "new",
      "at": "payload/.joycraft/runtime/cleanup.mjs:627",
      "summary": "Probe SM3: a submodule with ignore=all in .gitmodules moved to a new commit is invisible to git diff, so verify passes. git commit -a also leaves it out, so the tidy commit stays clean; same class as the round-1 U1 limit.",
      "assumption": "Verify needs to bound only what git commit -a would commit."
    },
    {
      "id": "f6-installed-copy",
      "class": "follow-up",
      "origin": "unknown",
      "at": ".joycraft/runtime/cleanup.mjs:1",
      "summary": "Round-1 follow-up still open: the installed .joycraft/runtime/cleanup.mjs still differs from payload/. Sync before release if AGENTS.md requires it."
    }

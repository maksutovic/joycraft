  "unresolved": [],
  "findings": [
    {
      "id": "f1-non-shell-c-accepted",
      "class": "blocking",
      "origin": "new",
      "criterion": "spec-7-1",
      "at": "payload/.joycraft/runtime/delivery.mjs:119",
      "summary": "runsGate accepts the gate as the last argument after -c, /c or -Command for any argv[0]. A genuine evidence.mjs receipt of `/bin/echo -c \"node gate.mjs\"` (green, HEAD, clean) pushed, although the gate never ran (probe case 5d, spec-07-probe.log). Fix: accept the -c form only when argv[0] basename is a shell (sh, bash, zsh, dash, cmd, cmd.exe, powershell, pwsh), and add a test for a non-shell -c receipt."
    },
    {
      "id": "f2-forged-footer-limit",
      "class": "follow-up",
      "origin": "pre-existing",
      "at": "payload/.joycraft/runtime/delivery.mjs:110",
      "summary": "Raised in the spec 3 review: a hand-written receipt with a green footer pushes (probe case 1, real gate red). The gate check stops mistakes, not a deliberate writer. Brief rule \"every proof states its limit\": say this limit in the delivery usage or coordinator text (spec 15).",
      "assumption": "The spec asks what the footer shows, not that it is authentic; so not a spec-7-1 failure."
    },
    {
      "id": "f3-duplicate-parser",
      "class": "follow-up",
      "origin": "pre-existing",
      "at": "payload/.joycraft/runtime/delivery.mjs:110",
      "summary": "Raised in the spec 3 review: delivery.mjs receiptFooter copies evidence.mjs readFooter. Observed difference: readFooter reads the last 64 KiB and requires record(); receiptFooter reads the whole file and accepts arrays (an array footer still ends as gate-receipt-not-gate, so no bypass). Import readFooter so they cannot drift."
    },
    {
      "id": "f4-receipt-outside-project",
      "class": "follow-up",
      "origin": "new",
      "at": "payload/.joycraft/runtime/delivery.mjs:124",
      "summary": "--gate-receipt takes an absolute path or ../ outside the project (probe case 8 pushed). evidence.mjs keeps receipts inside the project; delivery could refuse the same way. The spec does not decide it."
    },
    {
      "id": "f5-shell-flag-forms",
      "class": "follow-up",
      "origin": "new",
      "at": "payload/.joycraft/runtime/delivery.mjs:119",
      "summary": "A real shell receipt like `bash -lc \"<gate>\"` is refused as not-gate (safe false negative); words() also collapses whitespace inside quoted arguments. Worth one line in the delivery text on which forms count."
    }
  ],

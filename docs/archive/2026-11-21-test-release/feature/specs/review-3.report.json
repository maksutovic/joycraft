  "unresolved": [],
  "findings": [
    {
      "id": "f1-tail-window",
      "class": "follow-up",
      "origin": "new",
      "at": "payload/.joycraft/runtime/evidence.mjs:222",
      "summary": "readEnd caps the read at 256 KiB, so when the last 40 lines are wider than that the tail has fewer than 40 lines and its first line is cut mid-line (60 lines of 10 KiB: 26 lines; a cut can begin with U+FFFD in multibyte output). The bound is sensible against huge JSON; the spec does not decide it. Either document \"last 40 lines, at most 256 KiB\" or drop the partial first line.",
      "assumption": "A bounded tail is closest to the brief's intent (a short failing tail), so this does not fail spec-3-4, whose named check passes."
    },
    {
      "id": "f2-footer-not-authentic",
      "class": "follow-up",
      "origin": "new",
      "at": "payload/.joycraft/runtime/delivery.mjs:110",
      "summary": "The footer is integrity-bound by the receipt hash only after it is recorded; nothing proves evidence.mjs wrote it. A hand-written receipt with a forged footer reads the same to readFooter and to delivery.mjs receiptFooter (spec 7 gate receipt). Outside spec 3; noted for the gate-receipt owner."
    },
    {
      "id": "f3-duplicate-parser",
      "class": "follow-up",
      "origin": "new",
      "at": "payload/.joycraft/runtime/delivery.mjs:110",
      "summary": "delivery.mjs keeps its own copy of the footer parser instead of importing readFooter from evidence.mjs; the two can drift (delivery accepts any object, readFooter requires record())."
    }
  ],
  "limits": [
    "Windows load path simulated, not run on Windows.",
    "Installed .joycraft/runtime/evidence.mjs is still the pre-change copy; the payload copy was reviewed and used."
  ],

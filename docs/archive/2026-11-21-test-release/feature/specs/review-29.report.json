    {
      "id": "f4-shell-form-edges",
      "class": "follow-up",
      "origin": "new",
      "criterion": "spec-29-3",
      "at": "payload/.joycraft/runtime/dispatch-start.mjs:111-125, :133-136",
      "summary": "Probe: not detected as shell form (the spec list allows this): a single & (background), a FOO=1 env prefix (argv form runs \"FOO=1\" as the program), $HOME, a # comment, and $( or a backtick inside double quotes (the shell would expand them). In shell form a {files} written inside quotes (\"{files}\" or '{files}') nests the shellQuote quotes and breaks the word, and inside double quotes a file path with $( would expand. All need an unusual template; a later spec could treat an env prefix and a single & as shell form and refuse a quoted {files}."
    },

  "findings": [
    {
      "id": "r3-f1-quoted-names-misreason",
      "class": "follow-up",
      "origin": "new",
      "at": "payload/.joycraft/runtime/cleanup.mjs:820",
      "summary": "A doc name with a tab or double quote is skipped with \"Git shows no commit for it, so its age is unknown.\" The real cause: `git log --name-only` C-quotes such names even with core.quotepath=false, so the log map misses them. The doc is not dropped, and the attended pass says the reason, but the reason is wrong. Rare. Fix direction: read log names with -z.",
      "assumption": "Very rare names; a visible skip is acceptable for this spec."
    },

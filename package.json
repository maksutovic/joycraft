{
  "name": "joycraft",
  "version": "1.2.2",
  "description": "Install and update Joycraft, a skill bundle and runtime for agent-led software work, in any project",
  "type": "module",
  "bin": {
    "joycraft": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "payload"
  ],
  "joycraft": {
    "release": "1.2.2",
    "summary": "The README describes the 1.2 review loop, the install prompt shows what setup found, and an update names what is new and offers the question style.",
    "autoSafeEligible": false
  },
  "scripts": {
    "build": "node scripts/generate-bundled-files.mjs && node scripts/sync-skills.mjs && tsup && node scripts/release-preparation.mjs emit-descriptor",
    "sync-skills": "node scripts/generate-bundled-files.mjs && node scripts/sync-skills.mjs",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "claude-code",
    "ai",
    "development",
    "harness",
    "scaffolding"
  ],
  "author": "Maximilian Maksutovic",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maksutovic/joycraft"
  },
  "homepage": "https://github.com/maksutovic/joycraft#readme",
  "bugs": {
    "url": "https://github.com/maksutovic/joycraft/issues"
  },
  "packageManager": "pnpm@10.19.0",
  "dependencies": {
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.75.5",
    "@sinclair/typebox": "^0.34.49",
    "@types/node": "^22.13.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}

{
  "name": "joycraft",
  "version": "1.8.0",
  "description": "Install and update Joycraft, a skill bundle and runtime for agent-led software work, in any project",
  "type": "module",
  "bin": {
    "joycraft": "dist/cli.js"
  },
  "files": [
    "dist",
    "payload"
  ],
  "joycraft": {
    "release": "1.8.0",
    "summary": "Agents now run focused tests while they work, the project gate once per spec, and the full suite once on the PR. Reviewers block weakened tests, and cleanup can review your tests and CI when you ask.",
    "autoSafeEligible": false
  },
  "scripts": {
    "build": "tsup && node scripts/release-preparation.mjs emit-descriptor",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "claude-code",
    "ai",
    "development",
    "harness",
    "scaffolding"
  ],
  "author": "Maximilian Maksutovic",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maksutovic/joycraft"
  },
  "homepage": "https://github.com/maksutovic/joycraft#readme",
  "bugs": {
    "url": "https://github.com/maksutovic/joycraft/issues"
  },
  "packageManager": "pnpm@10.19.0",
  "dependencies": {
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}

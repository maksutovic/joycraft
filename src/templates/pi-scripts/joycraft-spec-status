#!/usr/bin/env bash
# joycraft-spec-status — Read .joycraft-spec-queue.json and print a formatted status table.
# Usage: joycraft-spec-status [specs-dir]

set -euo pipefail

SPECS_DIR="${1:-docs/features/*/specs}"
MANIFEST=$(ls "$SPECS_DIR"/.joycraft-spec-queue.json 2>/dev/null | head -1)

if [ -z "$MANIFEST" ]; then
  echo "No .joycraft-spec-queue.json found in $SPECS_DIR"
  exit 1
fi

# Parse JSON with grep+sed (no jq dependency).
#
# `grep -o '{[^}]*}'` is line-oriented, so it cannot see an object spanning
# several lines. `joycraft-decompose` documents a compact one-object-per-line
# manifest, but pretty-printed manifests (one key per line) are common in
# practice and used to yield an empty queue here — indistinguishable from a
# genuinely empty one. Collapsing each object onto a single line first makes
# both layouts parse identically. The manifest on disk is never rewritten.
normalize_manifest() {
  tr '\n' ' ' < "$1" | sed 's/}[[:space:]]*,/}\n/g; s/}[[:space:]]*]/}\n/g'
}

echo "Spec Queue Status"
echo "─────────────────"
echo ""

# Extract spec entries
while IFS= read -r line; do
  # Each spec entry looks like: { "id": 1, "file": "...", "depends_on": [...], "status": "..." }
  id=$(echo "$line" | sed -n 's/.*"id": *\([0-9]*\).*/\1/p')
  file=$(echo "$line" | sed -n 's/.*"file": *"\([^"]*\)".*/\1/p')
  status=$(echo "$line" | sed -n 's/.*"status": *"\([^"]*\)".*/\1/p')
  
  if [ -n "$id" ] && [ -n "$file" ] && [ -n "$status" ]; then
    # Glyphs per docs/reference/spec-status-lifecycle.md
    case "$status" in
      done)      marker="[✓]" ;;
      in-review) marker="[~]" ;;
      *)         marker="[ ]" ;;  # todo (and any unknown) render as not-started
    esac
    printf "%s  #%s  %s  (%s)\n" "$marker" "$id" "$file" "$status"
  fi
done < <(normalize_manifest "$MANIFEST" | grep -o '{[^}]*}' | grep '"id"')
